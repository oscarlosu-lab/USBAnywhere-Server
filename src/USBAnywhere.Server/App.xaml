<Application x:Class="USBAnywhere.Server.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:USBAnywhere.Server"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Obsidian Precision Theme Tokens (v3.2.0) -->
        <SolidColorBrush x:Key="BgPrimary" Color="#0B0C0E"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#131417"/>
        <SolidColorBrush x:Key="BgTertiary" Color="#16171B"/>
        <SolidColorBrush x:Key="AccentColor" Color="#D2F800"/>
        <SolidColorBrush x:Key="AccentHover" Color="#B8DA00"/>
        <SolidColorBrush x:Key="HighlightColor" Color="#EF4444"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#EDEDED"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8E919A"/>
        <SolidColorBrush x:Key="BorderColor" Color="#22242A"/>
        <SolidColorBrush x:Key="StatusSuccess" Color="#D2F800"/>
        <SolidColorBrush x:Key="StatusWarning" Color="#F59E0B"/>
        <SolidColorBrush x:Key="StatusError" Color="#EF4444"/>
        <SolidColorBrush x:Key="StatusInfo" Color="#A1A1AA"/>
        <SolidColorBrush x:Key="DataGridBg" Color="#0B0C0E"/>
        <SolidColorBrush x:Key="DataGridAltBg" Color="#131417"/>
        <SolidColorBrush x:Key="DataGridHover" Color="#18191E"/>
        <SolidColorBrush x:Key="DataGridSelected" Color="#22242A"/>
    </Application.Resources>
</Application>