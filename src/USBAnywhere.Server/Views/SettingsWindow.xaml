<Window x:Class="USBAnywhere.Server.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚙️ Settings - USBAnywhere Server" 
        Height="560" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgPrimary}">
    
    <Window.Resources>
        <!-- Section Header Style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource HighlightColor}"/>
            <Setter Property="Margin" Value="0,15,0,8"/>
        </Style>
        
        <!-- CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        
        <!-- Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HighlightColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource BgSecondary}" Padding="20,15">
            <StackPanel>
                <TextBlock x:Name="txtTitle" Text="⚙️ Settings" FontSize="20" FontWeight="Bold" 
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="txtSubtitle" Text="Configure USBAnywhere Server preferences" FontSize="11" 
                           Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
        </Border>
        
        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,10">
            <StackPanel>
                
                <!-- GENERAL -->
                <TextBlock x:Name="secGeneral" Text="🏠 GENERAL" Style="{StaticResource SectionHeader}"/>
                <CheckBox x:Name="chkStartWithWindows" Content="Start with Windows"/>
                <CheckBox x:Name="chkStartMinimized" Content="Start minimized to System Tray"/>
                <CheckBox x:Name="chkShowNotifications" Content="Show balloon notifications"/>
                <CheckBox x:Name="chkCheckUpdates" Content="Check for updates on startup"/>
                
                <!-- AUTO-BIND -->
                <TextBlock x:Name="secAutoBind" Text="🔗 AUTO-BIND (Persistent USB Sharing)" Style="{StaticResource SectionHeader}"/>
                <CheckBox x:Name="chkAutoBind" Content="Enable Auto-Bind for shared devices"/>
                <TextBlock x:Name="txtAutoBindDesc" Text="When enabled, devices you share will automatically be re-shared whenever they are plugged in." 
                           FontSize="10" Foreground="{DynamicResource TextSecondary}" 
                           TextWrapping="Wrap" Margin="20,0,0,0"/>
                
                <!-- SECURITY -->
                <TextBlock x:Name="secSecurity" Text="🔒 SECURITY" Style="{StaticResource SectionHeader}"/>
                <CheckBox x:Name="chkWhitelist" Content="Enable IP Whitelist (Enforced via Windows Firewall)"/>
                <TextBlock Text="Note: USB/IP communicates without PIN authentication; security is strictly enforced via Firewall &amp; VPN." 
                           FontSize="10" Foreground="{DynamicResource TextSecondary}" 
                           TextWrapping="Wrap" Margin="20,0,0,0"/>
                
                <!-- NETWORK -->
                <TextBlock x:Name="secNetwork" Text="🌐 NETWORK (TCP Port 3240)" Style="{StaticResource SectionHeader}"/>
                <StackPanel Orientation="Horizontal" Margin="0,6">
                    <Button x:Name="btnFirewall" Content="🛡️ Configure Firewall" 
                            Style="{StaticResource ModernButton}" 
                            Click="BtnFirewall_Click" Padding="15,8"/>
                    <TextBlock x:Name="txtFirewallStatus" Text="Not configured" 
                               VerticalAlignment="Center" Margin="15,0,0,0"
                               Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                </StackPanel>
                
                <!-- ADVANCED -->
                <TextBlock x:Name="secAdvanced" Text="⚙️ ADVANCED" Style="{StaticResource SectionHeader}"/>
                <StackPanel Orientation="Horizontal" Margin="0,6">
                    <TextBlock x:Name="lblRefreshInterval" Text="Refresh interval:" VerticalAlignment="Center" 
                               Foreground="{DynamicResource TextPrimary}" FontSize="12"/>
                    <TextBox x:Name="txtRefreshInterval" Width="50" Margin="10,0" 
                             Text="3" TextAlignment="Center"
                             Background="{DynamicResource BgSecondary}" 
                             Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource AccentColor}"/>
                    <TextBlock x:Name="lblSeconds" Text="seconds" VerticalAlignment="Center" 
                               Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                </StackPanel>
                
                <!-- IMPORT/EXPORT -->
                <TextBlock x:Name="secBackup" Text="💾 BACKUP" Style="{StaticResource SectionHeader}"/>
                <StackPanel Orientation="Horizontal" Margin="0,6">
                    <Button x:Name="btnExport" Content="📤 Export" 
                            Style="{StaticResource ModernButton}" 
                            Click="BtnExport_Click" Padding="15,8" Margin="0,0,10,0"/>
                    <Button x:Name="btnImport" Content="📥 Import" 
                            Style="{StaticResource ModernButton}" 
                            Click="BtnImport_Click" Padding="15,8"/>
                </StackPanel>
                
            </StackPanel>
        </ScrollViewer>
        
        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="{DynamicResource BgSecondary}" Padding="20,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnReset" Content="Reset to Defaults" Style="{StaticResource ModernButton}" 
                        Click="BtnReset_Click" Padding="15,10" Margin="0,0,10,0"
                        Background="#7f8c8d"/>
                <Button x:Name="btnCancel" Content="Cancel" Style="{StaticResource ModernButton}" 
                        Click="BtnCancel_Click" Padding="15,10" Margin="0,0,10,0"
                        Background="#95a5a6"/>
                <Button x:Name="btnSave" Content="💾 Save" Style="{StaticResource ModernButton}" 
                        Click="BtnSave_Click" Padding="20,10"
                        Background="#27ae60"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>